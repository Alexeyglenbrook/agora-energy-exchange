<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ToBe" targetNamespace="http://agora.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:collaboration id="Collaboration_ToBe">
    <bpmn:participant id="Participant_ToBe" name="Акредитація учасника — TO-BE (платформа «Агора»)" processRef="Process_ToBe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ToBe">
      <bpmn:lane id="Lane_Committee2" name="Біржовий комітет">
        <bpmn:flowNodeRef>Gateway_CommitteeDecision2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AML2" name="Фінансовий моніторинг">
        <bpmn:flowNodeRef>Gateway_AmlOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAML2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Legal2" name="Юридичний відділ">
        <bpmn:flowNodeRef>Gateway_LegalOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckLegal2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система «Агора»">
        <bpmn:flowNodeRef>Task_AutoCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PackageOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoActivate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Active2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateDocs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Applicant2" name="Заявник (кабінет)">
        <bpmn:flowNodeRef>StartEvent_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignKep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Training</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_2" name="Старт">
      <bpmn:outgoing>SF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SubmitApp" name="Подати заявку (статус: Подано)">
      <bpmn:incoming>SF1</bpmn:incoming>
      <bpmn:incoming>SF4</bpmn:incoming>
      <bpmn:incoming>SF8_no</bpmn:incoming>
      <bpmn:outgoing>SF2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AutoCheck" name="Автоперевірка комплектності">
      <bpmn:incoming>SF2</bpmn:incoming>
      <bpmn:outgoing>SF3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_PackageOk" name="Пакет повний?">
      <bpmn:incoming>SF3</bpmn:incoming>
      <bpmn:outgoing>SF4</bpmn:outgoing>
      <bpmn:outgoing>SF5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="ParallelGateway_Split" name="паралельно">
      <bpmn:incoming>SF5</bpmn:incoming>
      <bpmn:outgoing>SF6</bpmn:outgoing>
      <bpmn:outgoing>SF7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_LegalOk" name="Документи коректні?">
      <bpmn:incoming>Flow_1kjdasl</bpmn:incoming>
      <bpmn:outgoing>SF8_ok</bpmn:outgoing>
      <bpmn:outgoing>SF8_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_AmlOk" name="Підстав для відмови немає?">
      <bpmn:incoming>Flow_1w8ln8w</bpmn:incoming>
      <bpmn:outgoing>SF9_ok</bpmn:outgoing>
      <bpmn:outgoing>SF9_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="ParallelGateway_Join">
      <bpmn:incoming>SF8_ok</bpmn:incoming>
      <bpmn:incoming>SF9_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_1ucate9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_CommitteeDecision2" name="Рішення комітету">
      <bpmn:incoming>Flow_1ucate9</bpmn:incoming>
      <bpmn:outgoing>SF11</bpmn:outgoing>
      <bpmn:outgoing>SF12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Rejected2" name="Відмова (статус: Відхилено)">
      <bpmn:incoming>SF11</bpmn:incoming>
      <bpmn:incoming>SF9_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_SignKep" name="Підписати електронно (КЕП)">
      <bpmn:incoming>Flow_1f7g63m</bpmn:incoming>
      <bpmn:outgoing>SF14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Training" name="Пройти навчання (Навчальний центр)">
      <bpmn:incoming>SF14</bpmn:incoming>
      <bpmn:outgoing>SF15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AutoActivate" name="Автоматично активувати доступ (статус: Активний учасник)">
      <bpmn:incoming>SF15</bpmn:incoming>
      <bpmn:outgoing>SF16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Active2" name="Кінець">
      <bpmn:incoming>SF16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_GenerateDocs" name="Сформувати договір оренди та клірингове членство разом">
      <bpmn:incoming>SF12</bpmn:incoming>
      <bpmn:outgoing>Flow_1f7g63m</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SF1" sourceRef="StartEvent_2" targetRef="Task_SubmitApp" />
    <bpmn:sequenceFlow id="SF4" name="ні — заявник одразу бачить статус «Повернено»" sourceRef="Gateway_PackageOk" targetRef="Task_SubmitApp" />
    <bpmn:sequenceFlow id="SF2" sourceRef="Task_SubmitApp" targetRef="Task_AutoCheck" />
    <bpmn:sequenceFlow id="SF3" sourceRef="Task_AutoCheck" targetRef="Gateway_PackageOk" />
    <bpmn:sequenceFlow id="SF5" name="так" sourceRef="Gateway_PackageOk" targetRef="ParallelGateway_Split" />
    <bpmn:sequenceFlow id="SF6" sourceRef="ParallelGateway_Split" targetRef="Task_CheckLegal2" />
    <bpmn:sequenceFlow id="SF7" sourceRef="ParallelGateway_Split" targetRef="Task_CheckAML2" />
    <bpmn:sequenceFlow id="SF8_ok" name="так" sourceRef="Gateway_LegalOk" targetRef="ParallelGateway_Join" />
    <bpmn:sequenceFlow id="SF8_no" name="ні — юридичні зауваження, відділ акредитації оформляє повернення" sourceRef="Gateway_LegalOk" targetRef="Task_SubmitApp" />
    <bpmn:sequenceFlow id="SF9_ok" name="так" sourceRef="Gateway_AmlOk" targetRef="ParallelGateway_Join" />
    <bpmn:sequenceFlow id="SF9_no" name="ні — санкції, минаючи комітет (BR-03)" sourceRef="Gateway_AmlOk" targetRef="EndEvent_Rejected2" />
    <bpmn:sequenceFlow id="Flow_1ucate9" sourceRef="ParallelGateway_Join" targetRef="Gateway_CommitteeDecision2" />
    <bpmn:sequenceFlow id="SF11" name="відхилено" sourceRef="Gateway_CommitteeDecision2" targetRef="EndEvent_Rejected2" />
    <bpmn:sequenceFlow id="SF12" name="затверджено" sourceRef="Gateway_CommitteeDecision2" targetRef="Task_GenerateDocs" />
    <bpmn:sequenceFlow id="Flow_1f7g63m" sourceRef="Task_GenerateDocs" targetRef="Task_SignKep" />
    <bpmn:sequenceFlow id="SF14" sourceRef="Task_SignKep" targetRef="Task_Training" />
    <bpmn:sequenceFlow id="SF15" sourceRef="Task_Training" targetRef="Task_AutoActivate" />
    <bpmn:sequenceFlow id="SF16" sourceRef="Task_AutoActivate" targetRef="EndEvent_Active2" />
    <bpmn:task id="Task_CheckAML2" name="AML-перевірка у кабінеті">
      <bpmn:incoming>SF7</bpmn:incoming>
      <bpmn:outgoing>Flow_1w8ln8w</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckLegal2" name="Перевірити правовий статус у кабінеті">
      <bpmn:incoming>SF6</bpmn:incoming>
      <bpmn:outgoing>Flow_1kjdasl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1w8ln8w" sourceRef="Task_CheckAML2" targetRef="Gateway_AmlOk" />
    <bpmn:sequenceFlow id="Flow_1kjdasl" sourceRef="Task_CheckLegal2" targetRef="Gateway_LegalOk" />
  </bpmn:process>
